// Réglages VS Code pour le dépôt complet (dossier ouvert : P14DevIA/).
// Si tu ouvres plutôt le dossier "backend" tout seul, c'est le fichier
// backend/.vscode/settings.json qui s'applique.
{
  // Le Python du projet (dépendances installées par uv), et non celui du système.
  "python.defaultInterpreterPath": "backend/.venv/bin/python",

  // Racine des imports : l'équivalent de ce que fait tests/conftest.py au moment
  // de l'exécution. Sans cette ligne, Pylance ne sait pas où trouver "lib",
  // "models", "routers" et affiche des soulignements rouges.
  "python.analysis.extraPaths": ["backend/src"],

  // Tests : pytest est activé, il cherche dans backend/tests.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "backend",
  "python.testing.pytestArgs": ["tests"]
}
