DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/newsfoundry
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=60
FRONTEND_ORIGINS=http://localhost:3000

# IA : "test" = faux modèle (aucune clé requise). Toute autre valeur active le vrai modèle Mammouth.
AI_MODEL=test
MAMMOUTH_KEY=
API_KEY_WORLD=
APP_TIMEZONE=Europe/Paris

# Tracing MLflow (optionnel). Laisser vide = stockage SQLite local (backend/mlflow.db).
# Exemple avec serveur : MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=weather-agent
